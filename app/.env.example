# URL do backend (Next.js), sem barra no fim. Em desenvolvimento, o IP da sua
# máquina na rede local (ex.: http://192.168.0.10:3000), não "localhost":
# o celular não enxerga o localhost do computador.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google Sign-In: Client IDs "Web" e "iOS" do Google Cloud (públicos). O Client
# Secret vai só no painel do Supabase, nunca no app. Troque também o
# `iosUrlScheme` no app.json pelo Client ID iOS invertido.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# PostHog (opcional). Sem a chave, o analytics não envia nada.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
