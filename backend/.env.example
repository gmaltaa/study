# Supabase (projeto novo). A service role fica SÓ aqui no servidor, nunca no app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway. No deploy da Vercel a autenticação é automática (OIDC);
# localmente, use uma chave do Gateway.
AI_GATEWAY_API_KEY=
# Modelos por etapa (opcional). Ver lib/ai/models.ts.
AI_MODEL_PATH=
AI_MODEL_LESSON=
AI_MODEL_FAST=

# Inngest. Em desenvolvimento, use INNGEST_DEV=1 e `pnpm inngest` (servidor
# local); as chaves abaixo ficam vazias. Na Vercel, a integração do Inngest
# preenche as chaves e INNGEST_DEV não deve existir.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
